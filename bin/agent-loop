#!/usr/bin/env sh
#
# Wrapper for the "voku/agent-loop" CLI.
#
# The package requires PHP 8.3+, this library still supports PHP 7.x, so
# agent-loop is installed into an isolated tool project instead of into the
# root composer.json. See docs/agent-loop.md.
#
set -e

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
BIN="${ROOT}/tools/agent-loop/vendor/bin/agent-loop"

if [ ! -x "${BIN}" ]; then
  echo "agent-loop is not installed yet, run:" >&2
  echo "  composer install --working-dir=tools/agent-loop" >&2
  exit 1
fi

exec "${BIN}" "$@"
